              "path": ["componentes"]
            },
            "description": "El id no se puede enviar en el body (si no, save() pisaría el componente existente). 400 Bad Request."
          },
          "response": []
        },
        {
          "name": "Actualizar componente",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 199.99,\n  \"marca\": \"AMD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/componentes/1",
              "host": ["{{baseUrl}}"],
              "path": ["componentes", "1"]
            },
            "description": "Actualiza parcialmente un componente. 200 OK, o 404 si no existe el uso/componente."
          },
          "response": []
        },
        {
          "name": "Actualizar componente con precio negativo (400)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": -5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/componentes/1",
              "host": ["{{baseUrl}}"],
              "path": ["componentes", "1"]
            },
            "description": "En el PATCH solo se validan los campos enviados; un precio negativo es inválido. 400 Bad Request."
          },
          "response": []
        },
        {
          "name": "Actualizar componente con campo no permitido (400)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uso\": { \"id\": 999 }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/componentes/1",
              "host": ["{{baseUrl}}"],
              "path": ["componentes", "1"]
            },
            "description": "Solo se aceptan nombre, tipo, marca, precio y usoId. Un objeto uso (o cualquier campo raro) se rechaza; para cambiar el uso hay que mandar usoId. 400 Bad Request."
