          },
          "response": []
        },
        {
          "name": "Componente con ID no numérico (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/componentes/abc",
              "host": ["{{baseUrl}}"],
              "path": ["componentes", "abc"]
            },
            "description": "El id de la ruta no es un número. ParseIntPipe corta el pedido. 400 Bad Request."
          },
          "response": []
        },
        {
          "name": "Componente con ID fuera de rango (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/componentes/3000000000",
              "host": ["{{baseUrl}}"],
              "path": ["componentes", "3000000000"]
            },
            "description": "Un id mayor al máximo de un int de Postgres (2147483647) no puede existir. 404 Not Found."
          },
          "response": []
        },
        {
          "name": "Filtrar componentes con usoId no numérico (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/componentes?usoId=abc",
              "host": ["{{baseUrl}}"],
              "path": ["componentes"],
              "query": [
                {
                  "key": "usoId",
                  "value": "abc"
