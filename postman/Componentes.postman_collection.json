{
  "info": {
    "name": "Componentes - TP Tecnologias Web",
    "description": "Colección de Postman para la primera entrega del TP (backend NestJS + PostgreSQL). Entidades: Uso (1) -> Componente (N). Incluye CRUD de Usos y de Componentes, filtrado por uso, búsqueda por nombre, y casos de error (404 y 409).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Usos",
      "item": [
        {
          "name": "Listar usos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usos",
              "host": ["{{baseUrl}}"],
              "path": ["usos"]
            },
            "description": "Devuelve el listado completo de usos. 200 OK."
          },
          "response": []
        },
        {
          "name": "Obtener uso por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usos/1",
              "host": ["{{baseUrl}}"],
              "path": ["usos", "1"]
            },
            "description": "Devuelve un uso por su id. 200 OK, o 404 si no existe."
          },
          "response": []
        },
        {
          "name": "Crear uso",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Streaming\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/usos",
              "host": ["{{baseUrl}}"],
              "path": ["usos"]
            },
            "description": "Crea un uso nuevo. 201 Created."
          },
          "response": []
        },
        {
          "name": "Crear uso duplicado (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Gaming\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/usos",
              "host": ["{{baseUrl}}"],
              "path": ["usos"]
            },
            "description": "Intenta crear un uso con un nombre ya existente. 409 Conflict."
          },
          "response": []
        },
        {
          "name": "Actualizar uso",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Streaming y edición\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/usos/5",
              "host": ["{{baseUrl}}"],
              "path": ["usos", "5"]
            },
            "description": "Actualiza (parcialmente) un uso. 200 OK, o 404 si no existe."
          },
          "response": []
        },
        {
          "name": "Actualizar uso con nombre vacío (409)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"   \"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/usos/5",
              "host": ["{{baseUrl}}"],
              "path": ["usos", "5"]
            },
            "description": "Intenta dejar el nombre vacío / solo espacios. 409 Conflict."
          },
          "response": []
        },
        {
          "name": "Eliminar uso",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usos/5",
              "host": ["{{baseUrl}}"],
              "path": ["usos", "5"]
            },
            "description": "Elimina un uso sin componentes asociados. 200 OK (message + status)."
          },
          "response": []
        },
        {
          "name": "Eliminar uso con componentes asociados (409)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usos/1",
              "host": ["{{baseUrl}}"],
              "path": ["usos", "1"]
            },
            "description": "El uso 1 (Gaming) tiene componentes asociados: 409 Conflict."
          },
          "response": []
        },
        {
          "name": "Uso inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usos/999",
              "host": ["{{baseUrl}}"],
              "path": ["usos", "999"]
            },
            "description": "Uso que no existe. 404 Not Found."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Componentes",
      "item": [
        {
          "name": "Listar componentes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/componentes",
              "host": ["{{baseUrl}}"],
              "path": ["componentes"]
            },
            "description": "Lista todos los componentes con su uso embebido (relations). 200 OK."
          },
          "response": []
        },
        {
          "name": "Filtrar componentes por uso (?usoId=1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/componentes?usoId=1",
              "host": ["{{baseUrl}}"],
              "path": ["componentes"],
              "query": [{ "key": "usoId", "value": "1" }]
            },
            "description": "Filtra el listado por uso usando un query param. 200 OK."
          },
          "response": []
        },
        {
          "name": "Buscar componentes por nombre (?nombre=ryzen)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/componentes?nombre=ryzen",
              "host": ["{{baseUrl}}"],
              "path": ["componentes"],
              "query": [{ "key": "nombre", "value": "ryzen" }]
            },
            "description": "Búsqueda por coincidencia parcial en el nombre (case-insensitive). 200 OK. Combinable con ?usoId=."
          },
          "response": []
        },
        {
          "name": "Obtener componente por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/componentes/1",
              "host": ["{{baseUrl}}"],
              "path": ["componentes", "1"]
            },
            "description": "Devuelve un componente por id con su uso. 200 OK, o 404."
          },
          "response": []
        },
        {
          "name": "Crear componente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ryzen 5 5600\",\n  \"tipo\": \"Procesador\",\n  \"marca\": \"AMD\",\n  \"precio\": 220.5,\n  \"usoId\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/componentes",
              "host": ["{{baseUrl}}"],
              "path": ["componentes"]
            },
            "description": "Crea un componente asociado a un uso. 201 Created."
          },
          "response": []
        },
        {
          "name": "Crear componente con uso inexistente (404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Componente Fantasma\",\n  \"tipo\": \"Memoria RAM\",\n  \"marca\": \"Genérica\",\n  \"precio\": 50,\n  \"usoId\": 999\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/componentes",
              "host": ["{{baseUrl}}"],
              "path": ["componentes"]
            },
            "description": "El uso indicado no existe: 404 Not Found (validación de la relación)."
          },
          "response": []
        },
        {
          "name": "Actualizar componente",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio\": 199.99,\n  \"marca\": \"AMD\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/componentes/1",
              "host": ["{{baseUrl}}"],
              "path": ["componentes", "1"]
            },
            "description": "Actualiza parcialmente un componente. 200 OK, o 404 si no existe el uso/componente."
          },
          "response": []
        },
        {
          "name": "Eliminar componente",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/componentes/1",
              "host": ["{{baseUrl}}"],
              "path": ["componentes", "1"]
            },
            "description": "Elimina un componente. 200 OK (message + status)."
          },
          "response": []
        },
        {
          "name": "Componente inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/componentes/999",
              "host": ["{{baseUrl}}"],
              "path": ["componentes", "999"]
            },
            "description": "Componente que no existe. 404 Not Found."
          },
          "response": []
        }
      ]
    }
  ]
}
